            <constraints/>
            <properties>
              <editable value="false"/>
              <lineWrap value="true"/>
              <wrapStyleWord value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="e429f" class="javax.swing.JLabel" binding="labelIp">
        <constraints>
